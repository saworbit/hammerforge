# Godot 4+ specific ignores
.godot/
/android/

# Godot export presets
export.cfg
export_presets.cfg

# Mono (if ever enabled)
.mono/

# Build outputs
*.tmp
*.log
gut-results*.xml

# OS files
Thumbs.db
Desktop.ini
.DS_Store
nul

# IDEs/editors
.vscode/*
!.vscode/tasks.json
!.vscode/extensions.json
.idea/
.claude/
.hammerforge/
.appdata/
.localappdata/

# Local environment and Codex client state. MCP client configuration and
# authentication are machine-local and must not be committed.
.env
.env.*
!.env.example
.codex/

# HammerForge user state (should live in editor config, not repo)
io_presets.json

# Editor bridge state and diagnostic captures written at res:// by mistake.
# Canonical settings belong under Godot's user:// directory, never in source.
/mcp_settings.cfg
/mcp_tool_state.cfg
/mcp_tool_verification_log.json
/hammerforge_mcp_editor.png
/hammerforge_mcp_editor.png.import
/hammerforge_editor_window.png

# addons/ is an allowlist. This repository vendors the plugin, the test
# framework and the capture tool, and nothing else. An MCP server or any other
# editor bridge is a contributor's own local choice, so it stays out of the
# commit rather than being vendored for everyone. Adding a folder here is a
# deliberate act, which is the point.
/addons/*
!/addons/hammerforge/
!/addons/gut/
!/addons/hf_docshot/

# Python cache (if used for scripts/tools)
__pycache__/
*.pyc

# Brand asset generators — npm writes these when raster.js is run locally
docs/brand/node_modules/
docs/brand/package.json
docs/brand/package-lock.json

# Godot writes an .import beside every brand asset the moment the project is
# imported. They are cache, they reappear on every machine, and they are not
# what the docs site or the README serve. The addon's own branding/ imports are
# tracked, because those are resources the plugin loads at runtime.
docs/brand/png/*.import
docs/brand/svg/*.import

# MkDocs build output
.site/
.docshot-backup/

# CI downloads the Godot build to this name in the workspace root. It was once
# swept into a commit by an unscoped `git add -A` in the test-count step.
/godot.zip
