{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "GUT: Run All Tests",
            "type": "shell",
            "command": "${env:GODOT}",
            "args": [
                "--headless",
                "-s", "res://addons/gut/gut_cmdln.gd",
                "--path", ".",
                "-gexit"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": [
                {
                    "owner": "godot-script-error",
                    "fileLocation": ["relative", "${workspaceFolder}"],
                    "pattern": [
                        {
                            "regexp": "^(?:SCRIPT )?ERROR:\\s+(.+)$",
                            "message": 1
                        },
                        {
                            "regexp": "^\\s+at:\\s+\\S+\\s+\\(res://((?!addons/gut/)[^:]+\\.gd):(\\d+)\\)$",
                            "file": 1,
                            "line": 2
                        }
                    ],
                    "severity": "error"
                }
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "GUT: Run Current File",
            "type": "shell",
            "command": "${env:GODOT}",
            "args": [
                "--headless",
                "-s", "res://addons/gut/gut_cmdln.gd",
                "--path", ".",
                "-gselect=${fileBasenameNoExtension}",
                "-gexit"
            ],
            "group": "test",
            "problemMatcher": [
                {
                    "owner": "godot-script-error",
                    "fileLocation": ["relative", "${workspaceFolder}"],
                    "pattern": [
                        {
                            "regexp": "^(?:SCRIPT )?ERROR:\\s+(.+)$",
                            "message": 1
                        },
                        {
                            "regexp": "^\\s+at:\\s+\\S+\\s+\\(res://((?!addons/gut/)[^:]+\\.gd):(\\d+)\\)$",
                            "file": 1,
                            "line": 2
                        }
                    ],
                    "severity": "error"
                }
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "GUT: Run Current Test Method",
            "type": "shell",
            "command": "${env:GODOT}",
            "args": [
                "--headless",
                "-s", "res://addons/gut/gut_cmdln.gd",
                "--path", ".",
                "-gselect=${fileBasenameNoExtension}",
                "-gunit_test_name=${selectedText}",
                "-gexit"
            ],
            "group": "test",
            "problemMatcher": [
                {
                    "owner": "godot-script-error",
                    "fileLocation": ["relative", "${workspaceFolder}"],
                    "pattern": [
                        {
                            "regexp": "^(?:SCRIPT )?ERROR:\\s+(.+)$",
                            "message": 1
                        },
                        {
                            "regexp": "^\\s+at:\\s+\\S+\\s+\\(res://((?!addons/gut/)[^:]+\\.gd):(\\d+)\\)$",
                            "file": 1,
                            "line": 2
                        }
                    ],
                    "severity": "error"
                }
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "Godot: Import Project",
            "type": "shell",
            "command": "${env:GODOT}",
            "args": [
                "--headless",
                "--import",
                "--path", "."
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        }
    ]
}
